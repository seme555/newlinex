{
  "title": "Sales Pipeline Observability",
  "tags": ["pipeline", "sales", "airflow"],
  "timezone": "browser",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Airflow Health",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"airflow\"}",
          "legendFormat": "Airflow Status"
        }
      ],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {"text": "UP", "color": "green"},
                "0": {"text": "DOWN", "color": "red"}
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "MinIO Health",
      "type": "stat",
      "targets": [
        {
          "expr": "minio_cluster_health_status",
          "legendFormat": "MinIO Status"
